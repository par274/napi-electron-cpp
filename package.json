{
    "name": "napi-electron-cpp",
    "version": "1.0.0",
    "description": "A simple Electron app with C++ native addon",
    "main": "dist/main.js",
    "author": "https://github.com/par274",
    "license": "MIT",
    "homepage": "https://github.com/par274/napi-electron-cpp",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/par274/napi-electron-cpp.git"
    },
    "bugs": {
        "url": "https://github.com/par274/napi-electron-cpp/issues"
    },
    "engines": {
        "node": ">=20.0.0"
    },
    "keywords": [
        "electron",
        "react",
        "typescript",
        "cpp",
        "native-addon",
        "napi",
        "cmake",
        "desktop-app",
        "cross-platform"
    ],
    "type": "module",
    "scripts": {
        "build:native": "cmake-js configure -G Ninja -O build/ninja64 && cmake-js compile --runtime=electron --runtime-version=28.0.0 --arch=x64 -O build/x64",
        "dev": "vite",
        "build": "npm run build:native && vite build",
        "preview": "vite preview",
        "start": "npm run build && electron .",
        "dist:portable": "npm run build && electron-builder --config dist/config.cjs --dir",
        "dist:installer": "npm run build && electron-builder --config dist/config.cjs",
        "dist:ci": "npm run build && electron-builder --config dist/config.cjs",
        "clean": "rimraf dist release build"
    },
    "dependencies": {
        "node-addon-api": "^7.1.0",
        "react": "^19.0.0",
        "react-dom": "^19.0.0"
    },
    "devDependencies": {
        "@types/node": "^20.10.0",
        "@types/react": "^19.0.0",
        "@types/react-dom": "^19.0.0",
        "@vitejs/plugin-react": "^4.2.1",
        "cmake-js": "^7.2.1",
        "electron": "^28.0.0",
        "electron-builder": "^24.9.1",
        "rimraf": "^6.1.2",
        "typescript": "^5.9.3",
        "vite": "^5.0.10",
        "vite-plugin-electron": "^0.28.0",
        "vite-plugin-electron-renderer": "^0.14.5"
    }
}