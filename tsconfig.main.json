{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "module": "commonjs",
        "outDir": "./dist",
        "skipLibCheck": true,
        "noEmit": false
    },
    "include": [
        "src/main.ts",
        "src/preload.ts"
    ],
    "exclude": [
        "node_modules",
        "src/renderer.tsx"
    ]
}